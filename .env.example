# Copy this file to .env.local and fill in the values.

# Your live domain, e.g. https://genclosers.in (used for SEO and share links)
NEXT_PUBLIC_SITE_URL=

# Google Apps Script web app URL for the application form (see docs/google-sheet-setup.md)
NEXT_PUBLIC_FORM_ENDPOINT=

# Supabase (Project Settings > API). The service role key is secret: server only, never NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
